int led = 13;

void setup()
{
    pinMode(led, OUTPUT);
    Serial.begin(9600);
}

void loop()
{
    Serial.println("Simulating LED Blinking...");

    for(int i = 1; i <= 5; i++)
    {
        digitalWrite(led, HIGH);
        Serial.println("LED ON");
        delay(1000);

        digitalWrite(led, LOW);
        Serial.println("LED OFF");
        delay(1000);
    }

    Serial.println("Simulation Complete.");
    while(1);
}
