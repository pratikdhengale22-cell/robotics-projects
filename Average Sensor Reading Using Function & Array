#include <stdio.h>

float calculateAverage(int arr[], int n)
{
    int sum = 0;
    
    for (int i = 0; i < n; i++)
    {
        sum += arr[i];
    }

    return (float)sum / n;
}

int main()
{
    int readings[5];
    int i;
    float average;

    printf("Enter 5 sensor readings:\n");

    for (i = 0; i < 5; i++)
    {
        scanf("%d", &readings[i]);
    }

    average = calculateAverage(readings, 5);

    printf("Average Sensor Reading = %.2f\n", average);

    return 0;
}
