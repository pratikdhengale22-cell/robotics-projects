#include <stdio.h>

int main()
{
    int readings[5];
    int *ptr;
    int i;

    ptr = readings;

    printf("Enter 5 Sensor Readings:\n");

    for (i = 0; i < 5; i++)
    {
        scanf("%d", &readings[i]);
    }

    printf("\nSensor Readings using Pointers:\n");

    for (i = 0; i < 5; i++)
    {
        printf("Sensor %d: %d\n", i + 1, *(ptr + i));
    }

    return 0;
}
