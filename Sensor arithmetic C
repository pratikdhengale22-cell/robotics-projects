#include <stdio.h>

int main() {
    float sensor1, sensor2, sum;

    printf("Enter reading from Sensor 1: ");
    scanf("%f", &sensor1);

    printf("Enter reading from Sensor 2: ");
    scanf("%f", &sensor2);

    sum = sensor1 + sensor2;

    printf("Sum of sensor readings = %.2f\n", sum);

    return 0;
}
