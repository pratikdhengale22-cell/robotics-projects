#include <stdio.h>

int main()
{
    int sensor[5], i, j, temp;

    printf("Enter 5 sensor readings:\n");

    for(i = 0; i < 5; i++)
    {
        scanf("%d", &sensor[i]);
    }

    for(i = 0; i < 4; i++)
    {
        for(j = 0; j < 4 - i; j++)
        {
            if(sensor[j] > sensor[j + 1])
            {
                temp = sensor[j];
                sensor[j] = sensor[j + 1];
                sensor[j + 1] = temp;
            }
        }
    }

    printf("\nSorted Sensor Readings:\n");

    for(i = 0; i < 5; i++)
    {
        printf("%d ", sensor[i]);
    }

    return 0;
}
